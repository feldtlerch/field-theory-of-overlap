\newif\ifpaperxref
\paperxreffalse

\NewDocumentCommand{\papercref}{s m}{%
  \ifpaperxref
    \zcref{FTOO-#2}\IfBooleanT{#1}{, @PAGEABBR@~\zcpageref{FTOO-#2}}%
  \else
    \texttt{#2}%
  \fi}

\NewDocumentCommand{\papertitlecref}{s m}{%
  \ifpaperxref
    \zcref{FTOO-#2} (\ztitleref{FTOO-#2}\IfBooleanT{#1}{, @PAGEABBR@~\zcpageref{FTOO-#2}})%
  \else
    \texttt{#2}%
  \fi}

\IfFileExists{paper_xref.tex}{\input{paper_xref}\paperxreftrue}{}

\ExplSyntaxOn
\cs_new_protected:Npn \ftoo_ptag_bare:n #1
  { \hyperref[FTOO-#1]{ \ftoo_tagfont_ref:n {#1} } }
\cs_new_protected:Npn \ftoo_ptag_located:n #1
  { \ftoo_tagfont_ref:n {#1}~{\footnotesize(\zcref{FTOO-#1})} }
\NewDocumentCommand{\ptg}{s m}
  {
    \legacy_if:nTF { paperxref }
      {
        \IfBooleanTF{#1}
          { \ftoo_ptag_bare:n {#2} }
          {
            \prop_if_in:NnTF \g_ftoo_seen_prop {#2}
              { \ftoo_ptag_bare:n {#2} }
              {
                \prop_gput:Nnn \g_ftoo_seen_prop {#2} {1}
                \ftoo_ptag_located:n {#2}
              }
          }
      }
      { \ftoo_tagfont_ref:n {#2} }
  }

\NewDocumentCommand{\psee}{m}
  {
    \legacy_if:nTF { paperxref }
      { @RARROW@\,\zcref{FTOO-#1} }
      { \texttt{#1} }
  }

\NewDocumentCommand{\papervirtue}{m}
  {
    \ftoo_roster_admits:NnTF \g_ftoo_virtues_clist {#1}
      {
        \legacy_if:nTF { paperxref }
          { \hyperref[FTOO-v:#1]{ \textbf{\textit{#1}} } }
          { \textbf{\textit{#1}} }
      }
      { \msg_error:nnn { ftoo } { bad-virtue } {#1} }
  }

\cs_set:Npn \thestatement { \arabic{statement} }
\ExplSyntaxOff
\counterwithout*{statement}{section}

\NewDocumentCommand{\paperrefrain}{m m}{%
  \par\medskip
  \begin{center}{\itshape #2}\end{center}%
  \nobreak\vskip-\medskipamount\smallskip
  \IfBlankF{#1}{\noindent\hfill{\footnotesize\ptg*{#1}}\par}%
  \medskip\par
}

% The paragraph ends inside the size group, so the note keeps its own line spacing.
\NewDocumentCommand{\formalfoot}{m}{%
  \par\medskip\noindent{\footnotesize\textbf{@FORMALLY@}\enspace #1\par}}

\NewDocumentCommand{\gloss}{m m}{#1~{\footnotesize(\textit{#2})}}

\newif\ifexplainerfirstsection
\explainerfirstsectiontrue
\AddToHook{cmd/section/before}{%
  \ifexplainerfirstsection
    \global\explainerfirstsectionfalse
  \else
    \clearpage
  \fi}

\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{2}

\setversion{v@VERSION@}
\newcommand{\docdraft}{@DRAFT@}

\begin{document}
@SELECTLANG@
\subfile{@SUBFILE@}

\end{document}
